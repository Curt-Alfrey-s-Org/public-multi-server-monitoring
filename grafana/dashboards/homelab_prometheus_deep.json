      "id": 5,
      "type": "stat",
      "title": "Prometheus config OK",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "text": "FAIL"
                }
              },
              "id": "a"
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "color": "green",
                  "text": "OK"
                }
              },
              "id": "b"
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background"
