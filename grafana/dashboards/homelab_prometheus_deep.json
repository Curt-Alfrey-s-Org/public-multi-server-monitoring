            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "homelab:scrape_duration_seconds:mean_5m",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "pluginVersion": "11.0.0"
    },
