      "id": 18,
      "type": "table",
      "title": "up (instant) \u2014 0 means scrape failed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
