{
  "title": "Prometheus deep health (targets & scrapes)",
  "uid": "homelab-prom-deep",
  "tags": [
    "homelab",
    "prometheus",
    "sre"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Infrastructure overview",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/homelab-infrastructure",
      "targetBlank": false
    },
    {
      "title": "Prometheus UI (targets)",
      "type": "link",
      "icon": "external link",
      "url": "http://192.0.2.10:9092/targets",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets up (fraction)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "homelab:up:fraction",
          "refId": "A"
        }
      ],
      "pluginVersion": "11.0.0"
    },
